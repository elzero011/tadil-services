{
  "name": "tadil-alterations",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "test:admin-access-ui": "tsx scripts/verify-admin-access-ui.ts",
    "staff:bootstrap": "tsx libs/infra/tadil-database/prisma/bootstrap-staff.ts",
    "test:staff:integration": "node scripts/test-staff-auth.mjs",
    "test:staff": "jest --config apps/tadil-api/jest.auth.config.cjs --runInBand && tsx scripts/verify-endpoint-permissions.ts",
    "typecheck:admin-api": "tsc -p apps/tadil-api/tsconfig.check.json",
    "start-all": "nx run-many --target=serve tadil-api tadil-admin-web-client tadil-mobile-api tadil-mobile-app --parallel",
    "start-admin": "nx run-many --target=serve tadil-api tadil-admin-web-client",
    "start-admin-api": "nx serve tadil-api",
    "start-admin-ui": "nx serve tadil-admin-web-client",
    "start-mobile": "nx run-many --target=serve tadil-mobile-api tadil-mobile-app",
    "start-mobile-api": "nx serve tadil-mobile-api",
    "start-mobile-ui": "nx serve tadil-mobile-app",
    "build-admin-api": "nx build tadil-api",
    "build-mobile-api": "nx build tadil-mobile-api",
    "test": "nx test",
    "db-generate": "npm run prisma-generate -w tadil-database",
    "db-migrate-dev": "npm run prisma-migrate-dev -w tadil-database",
    "db-migrate-reset": "npm run prisma-reset -w tadil-database",
    "db-migrate-deploy": "npm run prisma-migrate-deploy -w tadil-database",
    "db-studio": "npm run prisma-studio -w tadil-database",
    "db-seed": "npm run prisma-seed -w tadil-database"
  },
  "private": true,
  "dependencies": {
    "argon2": "^0.44.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "11.0.0",
    "@nestjs/swagger": "11.0.0",
    "@nestjs/websockets": "11.0.0",
    "axios": "^1.6.0",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "22.0.2",
    "@nx/eslint-plugin": "22.0.2",
    "@nx/jest": "22.0.2",
    "@nx/js": "22.0.2",
    "@nx/nest": "22.0.2",
    "@nx/node": "22.0.2",
    "@nx/web": "22.0.2",
    "@nx/webpack": "22.0.2",
    "@nx/workspace": "22.0.2",
    "@swc-node/register": "~1.9.1",
    "@swc/cli": "~0.6.0",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@swc/jest": "~0.2.38",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "20.19.9",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.0.2",
    "prettier": "^2.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  },
  "workspaces": [
    "apps/tadil-api",
    "apps/tadil-mobile-api",
    "libs/infra/tadil-database",
    "libs/infra/file-storage",
    "libs/core/tadil-common",
    "libs/core/tadil-informations",
    "libs/core/tadil-models",
    "libs/core/tadil-alterations",
    "libs/core/tadil-extras",
    "libs/core/tadil-tailor",
    "libs/core/tadil-users",
    "libs/core/tadil-auth",
    "libs/infra/tadil-payment",
    "apps/tadil-admin-web-client",
    "apps/tadil-mobile-app",
    "libs/core/*"
  ]
}
