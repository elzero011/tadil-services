generator client {
    provider = "prisma-client-js"
}

generator json {
    provider = "prisma-json-types-generator"
}

datasource db {
    provider = "postgresql"
    url      = env("TADIL_DB")
}

enum ModelCategory {
    all
    men
    women
    kids
}

enum InformationType {
    text
    number
    select_menu
    checkbox
}

enum OrderStatus {
    pending
    waitingForTailorAssignement
    waitingForCourierAssignement
    waitingForPickupFromCustomer
    waitingForDropoffToTailor
    inProgress
    waitingForReturnCourierAssignement
    waitingForPickupFromTailor
    waitingForDropoffToCustomer
    done
}

enum LoginRequestStatus {
    PENDING
    APPROVED
    REJECTED
}

enum Role {
    tailor
    customer
    courier
}

enum TransactionType {
    EARNING
    PAYOUT
}

enum PayoutStatus {
    PENDING
    FULFILLED
    REJECTED
}

model Section {
    id          String   @id @default(uuid())
    englishName String
    arabicName  String
    urduName    String
    hindiName   String
    bengaliName String
    /// ![{x: number; y:number}]
    coordinates Json[]
    sorting     Int      @default(1)
    createdAt   DateTime @default(now())

    services     Alteration[] @relation("alterations-sections")
    modelImageId String
    image        ModelImage   @relation(fields: [modelImageId], references: [id], onDelete: Cascade)

    @@map("sections")
}

model ModelImage {
    id     String @id @default(uuid())
    fileId String

    modelId  String
    model    Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
    sections Section[]

    @@map("models-images")
}

model Model {
    id          String        @id @default(uuid())
    englishName String
    arabicName  String
    urduName    String
    hindiName   String
    bengaliName String
    category    ModelCategory @default(all)
    images      ModelImage[]

    @@map("models")
}

model Information {
    id          String          @id @default(uuid())
    englishName String
    arabicName  String
    urduName    String
    hindiName   String
    bengaliName String
    isRequired  Boolean         @default(false)
    type        InformationType @default(text)
    unit        String?
    sorting     Int             @default(1)

    services Alteration[] @relation("alterations-informations")
    extras   Extra[]      @relation("informations-extras")

    @@map("informations")
}

model Alteration {
    id          String @id @default(uuid())
    englishName String
    arabicName  String
    urduName    String
    hindiName   String
    bengaliName String
    price       Float
    sorting     Int    @default(1)

    sections     Section[]     @relation("alterations-sections")
    informations Information[] @relation("alterations-informations")

    @@map("alterations")
}

model Extra {
    id          String @id @default(uuid())
    englishName String
    arabicName  String
    urduName    String
    hindiName   String
    bengaliName String
    price       Float
    sorting     Int    @default(1)

    informations Information[] @relation("informations-extras")

    @@map("extras")
}

model OrderItemAlterationInformation {
    id          String          @id @default(uuid())
    englishName String
    arabicName  String
    urduName    String
    hindiName   String
    bengaliName String
    type        InformationType
    unit        String?
    value       String
    /// !{ id: string; englishName: string; arabicName: string; urduName: string; hindiName: string; bengaliName: string; price: number; }
    extraDetails Json?

    orderItemAlterationId String
    orderItemAlteration   OrderItemAlteration @relation(fields: [orderItemAlterationId], references: [id], onDelete: Cascade)

    @@map("order-item-alteration-informations")
}

model OrderItemAlteration {
    id                String @id @default(uuid())
    englishName       String
    arabicName        String
    urduName          String
    hindiName         String
    bengaliName       String
    price             Float
    /// ![{x: number; y:number}]
    customCoordinates Json[]

    informations       OrderItemAlterationInformation[]
    orderItemSectionId String?
    orderItemSection   OrderItemSection?                @relation(fields: [orderItemSectionId], references: [id], onDelete: Cascade)
    customOrderItemId  String?
    customOrderItem    CustomOrderItem?                 @relation(fields: [customOrderItemId], references: [id], onDelete: Cascade)

    @@map("order-item-alterations")
}

model OrderItemSection {
    id          String @id @default(uuid())
    englishName String
    arabicName  String
    urduName    String
    hindiName   String
    bengaliName String
    /// ![{x: number; y:number}]
    coordinates Json[]
    imageFileId String

    alterations OrderItemAlteration[]
    orderItemId String
    orderItem   OrderItem             @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

    @@map("order-item-sections")
}

model OrderItem {
    id          String @id @default(uuid())
    price       Float  @default(0)
    englishName String
    arabicName  String
    urduName    String
    hindiName   String
    bengaliName String
    imageFileId String

    sections OrderItemSection[]
    orderId  String
    order    Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

    @@map("order-items")
}

model CustomOrderItem {
    id          String @id @default(uuid())
    price       Float  @default(0)
    imageFileId String

    alterations OrderItemAlteration[]
    orderId     String
    order       Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)

    @@map("custom-order-items")
}

model Order {
    id         String      @id @default(uuid())
    reference  String      @unique()
    date       DateTime    @default(now())
    totalPrice Float       @default(0)
    status     OrderStatus

    items       OrderItem[]
    customItems CustomOrderItem[]

    customerId String
    customer   User   @relation("customer-orders", fields: [customerId], references: [id], onDelete: Cascade)

    addressId String?
    address   Address? @relation(fields: [addressId], references: [id])

    assignedTailorId String?
    assignedTailor   User?   @relation("user-assigned-order", fields: [assignedTailorId], references: [id], onDelete: Cascade)
    rejectedTailors  User[]  @relation("user-rejected-orders")

    assignedCourierId String?
    assignedCourier   User?   @relation("courier-assigned-order", fields: [assignedCourierId], references: [id], onDelete: Cascade)
    rejectedCouriers  User[]  @relation("courier-rejected-orders")

    assignedReturnCourierId String?
    assignedReturnCourier   User?   @relation("return-courier-assigned-order", fields: [assignedReturnCourierId], references: [id], onDelete: Cascade)
    rejectedReturnCouriers  User[]  @relation("return-courier-rejected-orders")

    history OrderStatusHistory[]
    chats   Chat[]

    @@map("orders")
}

model Chat {
    id        String         @id @default(uuid())
    orderId   String
    order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
    channel   MessageChannel
    /// !Message[]
    content   Json           @default("[]")
    updatedAt DateTime       @updatedAt

    @@unique([orderId, channel])
    @@map("chats")
}

enum MessageChannel {
    TAILOR
    COURIER
}

model OrderStatusHistory {
    id        String      @id @default(uuid())
    orderId   String
    order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
    status    OrderStatus
    timestamp DateTime    @default(now())

    @@map("order-status-histories")
}

model City {
    id       Int        @id
    regionId Int
    nameAr   String
    nameEn   String
    nameBn   String
    nameHi   String
    nameUr   String
    lat      Float?
    lng      Float?

    districts District[]

    @@index([regionId])
    @@map("cities")
}

model District {
    id       String @id
    cityId   Int
    regionId Int
    nameAr   String
    nameEn   String
    nameBn   String
    nameHi   String
    nameUr   String

    // GeoJSON Polygon geometry ({ type, coordinates }) of the district's area,
    // used to constrain a picked map point to within the district/city.
    boundaries Json?

    city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

    @@index([cityId])
    @@map("districts")
}

model Address {
    id        String  @id @default(uuid())
    // City and district are denormalized in both languages so any viewer can
    // render them in their own language. Ids are loose (no FK) so addresses
    // survive the seed wiping and reinserting city/district rows.
    cityId         Int?
    cityNameAr     String
    cityNameEn     String
    cityNameBn     String
    cityNameHi     String
    cityNameUr     String
    districtId     String?
    districtNameAr String?
    districtNameEn String?
    districtNameBn String?
    districtNameHi String?
    districtNameUr String?
    // Street is reverse-geocoded from the map pin once per language, so it can
    // render in the viewer's language too. The legacy `street` keeps the label
    // shown at pick time as a fallback.
    street    String?
    streetAr  String?
    streetEn  String?
    streetBn  String?
    streetHi  String?
    streetUr  String?
    latitude  Float?
    longitude Float?
    userId    String
    user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    orders Order[]

    @@map("addresses")
}

model User {
    id        String  @id @default(uuid())
    phone     String  @unique
    firstName String
    lastName  String
    email     String?
    role      Role

    loginRequestStatus LoginRequestStatus?
    loginToken         String?

    walletBalance  Float @default(0)
    commissionRate Float @default(10)
    sorting        Int   @default(1)

    addresses Address[]

    orders Order[] @relation("customer-orders")

    assignedOrders Order[] @relation("user-assigned-order")
    rejectedOrders Order[] @relation("user-rejected-orders")

    assignedCouriers Order[] @relation("courier-assigned-order")
    rejectedCouriers Order[] @relation("courier-rejected-orders")

    assignedReturnOrders Order[] @relation("return-courier-assigned-order")
    rejectedReturnOrders Order[] @relation("return-courier-rejected-orders")

    transactions   Transaction[]
    payoutRequests PayoutRequest[]

    @@map("users")
}

model Transaction {
    id        String          @id @default(uuid())
    reference String          @unique
    amount    Float
    type      TransactionType
    date      DateTime        @default(now())

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    orderId String?

    @@map("transactions")
}

model PayoutRequest {
    id     String       @id @default(uuid())
    amount Float
    status PayoutStatus @default(PENDING)
    date   DateTime     @default(now())

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("payout-requests")
}

model StaffAccount {
    id           String             @id @default(uuid())
    email        String             @unique
    name         String
    passwordHash String
    active       Boolean            @default(true)
    isSystemAdmin Boolean           @default(false)
    createdAt    DateTime           @default(now())
    updatedAt    DateTime           @updatedAt
    roles        StaffAccountRole[]
    grants       String[]           @default([])
    denials      String[]           @default([])
    sessions     StaffSession[]
    tokens       StaffToken[]
    audits       StaffAudit[]       @relation("staff-audit-actor")
}

model StaffRole {
    id        String             @id @default(uuid())
    name      String             @unique
    permissions String[]         @default([])
    isSystem  Boolean            @default(false)
    createdAt DateTime           @default(now())
    updatedAt DateTime           @updatedAt
    accounts  StaffAccountRole[]
}

model StaffAccountRole {
    accountId String
    roleId    String
    account   StaffAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
    role      StaffRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
    @@id([accountId, roleId])
}

model StaffSession {
    id        String       @id @default(uuid())
    tokenHash String       @unique
    csrfHash  String
    accountId String
    account   StaffAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
    expiresAt DateTime
    createdAt DateTime     @default(now())
    revokedAt DateTime?
}

model StaffToken {
    id        String       @id @default(uuid())
    tokenHash String       @unique
    type      String
    accountId String
    account   StaffAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
    expiresAt DateTime
    usedAt    DateTime?
    createdAt DateTime     @default(now())
}

model StaffAudit {
    id        String       @id @default(uuid())
    actorId   String?
    actor     StaffAccount? @relation("staff-audit-actor", fields: [actorId], references: [id], onDelete: SetNull)
    action    String
    targetType String
    targetId  String?
    metadata  Json?
    createdAt DateTime     @default(now())
}

model StaffLoginThrottle {
    email       String   @id
    failures    Int      @default(0)
    lockedUntil DateTime?
    updatedAt   DateTime @updatedAt
}
